# Production feature flags — committed, non-secret. Next.js loads this at build
# time (`next build`), so Vercel bakes them into every production/preview build
# with no dashboard step. Does NOT affect local `npm run dev` (that uses
# .env.local). NEVER put secrets here (Supabase service/secret key, etc.) — those
# belong in the Vercel dashboard env only.
NEXT_PUBLIC_FEATURE_PLAY_EXPERIENCE=true
NEXT_PUBLIC_FEATURE_TEE_IT_UP=true
NEXT_PUBLIC_FEATURE_NAV_V2=true
NEXT_PUBLIC_FEATURE_SHARE_CODE=true
NEXT_PUBLIC_FEATURE_ROSTER=true
NEXT_PUBLIC_FEATURE_GAME_TIME=true
